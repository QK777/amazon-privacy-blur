{
  "manifest_version": 3,
  "name": "Amazon 名前・住所マスク",
  "version": "1.0.11",
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "description": "Amazon.co.jpの注文履歴・注文詳細・住所帳などの名前・住所欄を、登録なしで自動的に隠します。標準は*表示。ぼかしにも切り替えられます。",
  "permissions": ["storage"],
  "action": {"default_popup": "popup.html", "default_title": "Amazon マスク", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}},
  "content_scripts": [{
    "matches": ["https://*.amazon.co.jp/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_start",
    "all_frames": true
  }]
}
